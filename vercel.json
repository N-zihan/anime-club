{
  "version": 2,
  "regions": [
    "bom1"
  ],
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.14",
        "installCommand": "pip install -r requirements.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ]
}